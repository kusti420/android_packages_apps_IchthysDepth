<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ichthys.depth">

    <!-- Privileged (privapp-permissions-org.ichthys.depth.xml). -->
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <!-- Signature: the lock wallpaper of whichever user SystemUI asks about, and the one provider
         instance for all users (singleUser). -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <!-- Direct boot aware: the lock screen needs its mask before the first unlock after a boot. The
         masks are in device-protected storage; they are cut out of the wallpaper, which the lock
         screen shows to anyone anyway. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:directBootAware="true"
        android:hasCode="true">

        <!-- The masks, for SystemUI only: a mask is cut out of the wallpaper, so it takes what
             reading the wallpaper takes. One instance for all users (the masks are per user). -->
        <provider
            android:name=".MaskProvider"
            android:authorities="org.ichthys.depth"
            android:exported="true"
            android:singleUser="true"
            android:readPermission="android.permission.READ_WALLPAPER_INTERNAL"
            android:writePermission="android.permission.READ_WALLPAPER_INTERNAL" />

        <!-- IchthysOS lock screen editor v2: the subject of a photo that is not the wallpaper yet
             (the editor's Ideas). Called with call(), which checks READ_WALLPAPER_INTERNAL itself. -->
        <provider
            android:name=".SegmentProvider"
            android:authorities="org.ichthys.depth.segment"
            android:exported="true"
            android:singleUser="true"
            android:readPermission="android.permission.READ_WALLPAPER_INTERNAL"
            android:writePermission="android.permission.READ_WALLPAPER_INTERNAL" />
    </application>
</manifest>
