// IchthysOS: IchthysDepth, the lock screen's depth cut-out (kusti420/ichthysos-tracker#58). Finds
// the subject of the lock wallpaper on the phone (U²-Netp salient object model, Apache-2.0, run by
// TFLite from external/tensorflow) and serves it as a mask to SystemUI, which draws the subject over
// the clock. The model runs here and not in SystemUI, so a native crash in it can't take the lock
// screen down. See README.md.
//
// Platform-signed priv-app: READ_WALLPAPER_INTERNAL (signature|privileged) to read the wallpaper,
// INTERACT_ACROSS_USERS_FULL for other users' wallpapers; hidden WallpaperManager APIs via
// platform_apis.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "IchthysDepth",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    // The model is memory-mapped straight out of the APK.
    aaptflags: [
        "-0",
        ".tflite",
    ],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "tensorflowlite_java",
        "kotlinx_coroutines",
    ],
    jni_libs: ["libtensorflowlite_jni"],
    use_embedded_native_libs: true,
    // TFLite's Java side is called back from JNI by name.
    optimize: {
        enabled: false,
    },
    required: [
        "privapp-permissions-org.ichthys.depth",
        "BigShouldersDisplay-VF.ttf",
        "Nunito-VF.ttf",
        "Rubik-VF.ttf",
        "Teko-VF.ttf",
        "SofiaSansCondensed-VF.ttf",
        "Anton-Regular.ttf",
        "Archivo-VF.ttf",
        "InterTight-VF.ttf",
        "ArchivoBlack-Regular.ttf",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-org.ichthys.depth",
    src: "privapp-permissions-org.ichthys.depth.xml",
    // Without an explicit filename prebuilt_etc installs it under the module name, with no .xml
    // extension, and SystemConfig skips it: enforce mode then crash-loops system_server.
    filename: "privapp-permissions-org.ichthys.depth.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

// Big Shoulders Display (SIL OFL 1.1, fonts/OFL.txt), the Depth face's digits
// (SettingsLib DepthClockView reads it from /system/fonts by path).
prebuilt_font {
    name: "BigShouldersDisplay-VF.ttf",
    src: "fonts/BigShouldersDisplay-VF.ttf",
}

// Nunito (SIL OFL 1.1, fonts/OFL-Nunito.txt), the Depth face's rounded digits (FONT_ROUNDED, close
// to SF Pro Rounded; SettingsLib DepthClockView reads it from /system/fonts by path).
prebuilt_font {
    name: "Nunito-VF.ttf",
    src: "fonts/Nunito-VF.ttf",
}

// Rubik (SIL OFL 1.1, fonts/OFL-Rubik.txt), the Depth face's FONT_SOFT digits.
prebuilt_font {
    name: "Rubik-VF.ttf",
    src: "fonts/Rubik-VF.ttf",
}

// Teko (SIL OFL 1.1, fonts/OFL-Teko.txt), the Depth face's FONT_TEKO digits.
prebuilt_font {
    name: "Teko-VF.ttf",
    src: "fonts/Teko-VF.ttf",
}

// Sofia Sans Condensed (SIL OFL 1.1, fonts/OFL-SofiaSansCondensed.txt), the Depth face's FONT_CONDENSED digits.
prebuilt_font {
    name: "SofiaSansCondensed-VF.ttf",
    src: "fonts/SofiaSansCondensed-VF.ttf",
}

// Anton (SIL OFL 1.1, fonts/OFL-Anton.txt), the Depth face's FONT_POSTER digits.
prebuilt_font {
    name: "Anton-Regular.ttf",
    src: "fonts/Anton-Regular.ttf",
}

// Archivo (SIL OFL 1.1, fonts/OFL-Archivo.txt), the Depth face's FONT_COMPACT digits.
prebuilt_font {
    name: "Archivo-VF.ttf",
    src: "fonts/Archivo-VF.ttf",
}

// Inter Tight (SIL OFL 1.1, fonts/OFL-InterTight.txt), the Depth face's FONT_GROTESK digits.
prebuilt_font {
    name: "InterTight-VF.ttf",
    src: "fonts/InterTight-VF.ttf",
}

// Archivo Black (SIL OFL 1.1, fonts/OFL-ArchivoBlack.txt), the Depth face's FONT_HEAVY digits.
prebuilt_font {
    name: "ArchivoBlack-Regular.ttf",
    src: "fonts/ArchivoBlack-Regular.ttf",
}
